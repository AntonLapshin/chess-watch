# Copy to server/.env (or repo-root .env) and fill in. Never commit real tokens.
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# Use the SAME tokens as the root .env (they are embedded in the watch build).
CHESS_TOKEN_P1=CHANGEME-p1-token-at-least-24-chars-long-00000001
CHESS_TOKEN_P2=CHANGEME-p2-token-at-least-24-chars-long-00000002
CHESS_P1_NAME=Aurora
CHESS_P2_NAME=Sam
# Loopback only: Cloudflare Tunnel (or another reverse proxy) is the only way in.
# Use 0.0.0.0 only for direct LAN access.
CHESS_HOST=127.0.0.1
CHESS_PORT=8787
CHESS_DB_PATH=./data/chess.sqlite3
CHESS_OFFER_TTL=120
CHESS_CORS_ORIGINS=http://localhost:5173,https://chess.gulfrenderstudio.com
