# systemd unit for the Chess Watch relay server.
# Install: sudo cp chess-watch.service /etc/systemd/system/
#          sudo systemctl daemon-reload
#          sudo systemctl enable --now chess-watch
# Edit User/WorkingDirectory/EnvironmentFile to match the install.
# IMPORTANT: exactly one worker (ExecStart has no --workers flag beyond 1);
# long-poll waiters live in this process, so a second worker would miss wakes.
[Unit]
Description=Chess Watch relay server
After=network.target

[Service]
Type=simple
User=anton
WorkingDirectory=/home/anton/chess-watch/server
EnvironmentFile=/home/anton/chess-watch/server/.env
ExecStart=/home/anton/chess-watch/server/.venv/bin/uvicorn app:app --host 0.0.0.0 --port 8787 --workers 1 --log-level info
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
