# Example unit installed by setup-tunnel.sh as
# /etc/systemd/system/cloudflared-chess-watch.service
#
# The relay itself is not a systemd dependency: cloudflared can start first
# and will return 502 until `make server` is running.
[Unit]
Description=Cloudflare Tunnel (chess-watch) for the Chess Watch relay
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=notify
ExecStart=/usr/bin/cloudflared tunnel --config /etc/cloudflared/chess-watch.yml run
Restart=always
RestartSec=5s
TimeoutStopSec=30
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
