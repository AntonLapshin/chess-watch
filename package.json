{
  "name": "chess-watch",
  "version": "0.2.2",
  "private": true,
  "type": "module",
  "scripts": {
    "config": "node scripts/gen-app-config.mjs",
    "pieces": "node scripts/gen-pieces.mjs",
    "icons": "node scripts/gen-icons.mjs",
    "test": "vitest run --config vitest.config.mjs",
    "test:watch": "vitest --config vitest.config.mjs",
