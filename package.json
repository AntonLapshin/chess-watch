    "preview": "npm run config && npx @zeppos/zeus-cli preview"
  },
  "dependencies": {
    "@zeppos/zml": "^0.0.43"
  },
  "devDependencies": {
    "@zeppos/device-types": "^4.0.0",
    "@zeppos/zeus-cli": "^1.10.0",
    "dotenv": "^17.0.0",
    "sharp": "^0.34.0",
    "vitest": "^2.1.0"
  }
}
