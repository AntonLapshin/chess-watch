{
  "configVersion": "v3",
  "app": {
    "appId": 1137599,
    "appName": "Chess Watch",
    "appType": "app",
    "version": {
      "code": 4,
      "name": "0.2.0"
    },
    "icon": "icon.png",
    "vender": "chess-watch",
    "description": "Two-player chess between two Amazfit watches, relayed by a Cloudflare Worker + Durable Object."
  },
  "permissions": [
    "data:os.device.info",
    "device:os.local_storage"
  ],
  "runtime": {
    "apiVersion": {
      "compatible": "4.0",
      "target": "4.0",
      "minVersion": "4.0"
    }
  },
  "targets": {
    "default": {
      "module": {
        "page": {
          "pages": ["page/index"]
        },
        "app-side": {
          "path": "app-side/index"
        }
      },
      "platforms": [
        { "st": "s", "dw": 390 },
        { "st": "r", "dw": 466 }
      ]
    }
  },
  "i18n": {
    "en-US": {
      "appName": "Chess Watch"
    }
  },
  "defaultLanguage": "en-US"
}
