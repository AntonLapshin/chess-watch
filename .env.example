# Copy to .env and fill in. This is the build-side config embedded in the
# watch bundle (and used by `make web`).
#
# CHESS_SERVER_URL is the Cloudflare Worker: https://chess.gulfrenderstudio.com
# in production. For local testing against `wrangler dev`, use
# http://localhost:8787 — the watch cannot reach localhost, so that URL is
# only useful for `make web` (the browser harness).
# Both `make web` and the watch builds use this value. To point only the
# browser harness at the local Worker without editing .env:
#   CHESS_SERVER_URL=http://localhost:8787 make web
#
# Generate tokens with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# Put the SAME tokens in `wrangler secret put CHESS_TOKEN_P1 / CHESS_TOKEN_P2`
# (production) or worker/.dev.vars (local `wrangler dev`).
CHESS_SERVER_URL=https://chess.gulfrenderstudio.com
CHESS_TOKEN_P1=CHANGEME-p1-token-at-least-24-chars-long-00000001
CHESS_TOKEN_P2=CHANGEME-p2-token-at-least-24-chars-long-00000002
CHESS_P1_NAME=Aurora
CHESS_P2_NAME=Sam
