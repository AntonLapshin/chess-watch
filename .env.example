# Copy to .env and fill in. This is the build-side config embedded in the
# watch bundle (and used by `make web`).
#
# On-device builds should use the public HTTPS hostname served by Cloudflare
# Tunnel, e.g. https://chess.gulfrenderstudio.com. A LAN/VPN address also
# works while the phone is on that network, but the watch cannot reach
# localhost. For `make web` only, http://localhost:8787 is fine.
#
# Generate tokens with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# Put the SAME tokens in server/.env.
CHESS_SERVER_URL=https://chess.gulfrenderstudio.com
CHESS_TOKEN_P1=CHANGEME-p1-token-at-least-24-chars-long-00000001
CHESS_TOKEN_P2=CHANGEME-p2-token-at-least-24-chars-long-00000002
CHESS_P1_NAME=Aurora
CHESS_P2_NAME=Sam

# Optional: Cloudflare Access service token for the tunnel hostname.
# Create it in Zero Trust -> Access -> Service Auth -> Service Tokens, then
# add a "Service Auth" policy for it on the Access application. Leave both
# empty when the server is reached directly over the LAN/VPN.
CHESS_CF_ACCESS_CLIENT_ID=
CHESS_CF_ACCESS_CLIENT_SECRET=
