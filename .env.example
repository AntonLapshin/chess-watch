# Copy to .env and fill in. The watch cannot reach localhost — use the LAN
# or VPN address of the machine running the server for on-device builds.
# For `make web` only, http://localhost:8787 is fine.
# Generate tokens with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
CHESS_SERVER_URL=http://192.168.1.10:8787
CHESS_TOKEN_P1=CHANGEME-p1-token-at-least-24-chars-long-00000001
CHESS_TOKEN_P2=CHANGEME-p2-token-at-least-24-chars-long-00000002
CHESS_P1_NAME=Aurora
CHESS_P2_NAME=Sam
